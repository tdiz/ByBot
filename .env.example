# ByBit API Configuration
# ВАЖНО: Скопируйте этот файл как .env и заполните своими реальными ключами
# IMPORTANT: Copy this file as .env and fill with your real keys
#
# Команда: cp .env.example .env
# Command: cp .env.example .env

# ByBit API Credentials
# Получите ключи здесь: https://www.bybit.com/app/user/api-management
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# Testnet credentials (для тестирования)
BYBIT_TESTNET_API_KEY=your_testnet_api_key_here
BYBIT_TESTNET_API_SECRET=your_testnet_api_secret_here

# Trading Configuration
USE_TESTNET=true  # true для тестовой сети, false для реальной торговли
TRADING_SYMBOL=BTCUSDT
TRADING_MODE=spot  # spot, linear (futures), или inverse

# Risk Management
MAX_POSITION_SIZE=1000  # Максимальный размер позиции в USDT
STOP_LOSS_PERCENT=2.0   # Стоп-лосс в процентах
TAKE_PROFIT_PERCENT=5.0 # Тейк-профит в процентах

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_TO_FILE=true
